{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/molai/state_transition.schema.json",
  "title": "Audit state-transition record",
  "type": "object",
  "required": [
    "schema_version",
    "transition_id",
    "contract_id",
    "observation_id",
    "recorded_at",
    "analysis_role",
    "audit_layer",
    "claim_id",
    "from_state",
    "to_state",
    "decision",
    "gate_evaluation",
    "reason",
    "decision_summary",
    "components",
    "input_sha256"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "transition_id": {
      "type": "string",
      "minLength": 1
    },
    "contract_id": {
      "type": "string",
      "minLength": 1
    },
    "observation_id": {
      "type": "string",
      "minLength": 1
    },
    "recorded_at": {
      "type": "string",
      "format": "date-time"
    },
    "analysis_role": {
      "enum": [
        "benchmark_admission",
        "post_stop_diagnostic",
        "scientific_reentry"
      ]
    },
    "audit_layer": {
      "enum": [
        "source",
        "estimand",
        "stressor",
        "construct",
        "model",
        "reentry"
      ]
    },
    "claim_id": {
      "type": "string",
      "minLength": 1
    },
    "from_state": {
      "enum": [
        "AUDIT_PENDING",
        "ADMITTED",
        "STOPPED",
        "REVISION_REQUIRED"
      ]
    },
    "to_state": {
      "enum": [
        "ADMITTED",
        "STOPPED",
        "REVISION_REQUIRED"
      ]
    },
    "decision": {
      "enum": [
        "GO",
        "STOP",
        "REVISE"
      ]
    },
    "gate_evaluation": {
      "type": "object",
      "required": [
        "metric",
        "observed",
        "operator",
        "threshold",
        "passed"
      ],
      "properties": {
        "metric": {
          "type": "string",
          "minLength": 1
        },
        "observed": {
          "type": [
            "number",
            "null"
          ]
        },
        "operator": {
          "enum": [
            "==",
            "!=",
            "<",
            "<=",
            ">",
            ">="
          ]
        },
        "threshold": {
          "type": "number"
        },
        "passed": {
          "type": [
            "boolean",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "reason": {
      "type": "string",
      "minLength": 1
    },
    "decision_summary": {
      "type": "string",
      "minLength": 1
    },
    "components": {
      "type": "object",
      "required": [
        "retained",
        "revised",
        "replaced"
      ],
      "properties": {
        "retained": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/component"
          }
        },
        "revised": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/component"
          }
        },
        "replaced": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/component"
          }
        }
      },
      "additionalProperties": false
    },
    "input_sha256": {
      "type": "object",
      "required": [
        "contract",
        "observation"
      ],
      "properties": {
        "contract": {
          "type": "string",
          "pattern": "^[A-Fa-f0-9]{64}$"
        },
        "observation": {
          "type": "string",
          "pattern": "^[A-Fa-f0-9]{64}$"
        }
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "component": {
      "enum": [
        "population",
        "estimand",
        "implementation",
        "contract",
        "test"
      ]
    }
  },
  "additionalProperties": false
}
