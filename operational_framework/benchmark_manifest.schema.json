{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/molai/benchmark_manifest.schema.json",
  "title": "Benchmark manifest",
  "type": "object",
  "required": [
    "schema_version",
    "benchmark_id",
    "version",
    "source",
    "assets",
    "splits",
    "identity_rule"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "benchmark_id": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "source": {
      "type": "object",
      "required": [
        "name",
        "locator",
        "access_note",
        "license_note"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "locator": {
          "type": "string",
          "minLength": 1
        },
        "access_note": {
          "type": "string",
          "minLength": 1
        },
        "license_note": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "assets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "asset_id",
          "role",
          "locator",
          "redistribution"
        ],
        "properties": {
          "asset_id": {
            "type": "string",
            "minLength": 1
          },
          "role": {
            "enum": [
              "primary_data",
              "derived_data",
              "code",
              "model",
              "metadata"
            ]
          },
          "locator": {
            "type": "string",
            "minLength": 1
          },
          "revision": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[A-Fa-f0-9]{64}$"
          },
          "redistribution": {
            "enum": [
              "included",
              "reference_only",
              "restricted"
            ]
          }
        },
        "additionalProperties": false
      }
    },
    "splits": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "name",
          "role",
          "rows_total"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "role": {
            "enum": [
              "reference",
              "calibration",
              "evaluation",
              "other"
            ]
          },
          "rows_total": {
            "type": "integer",
            "minimum": 0
          },
          "rows_valid": {
            "type": "integer",
            "minimum": 0
          }
        },
        "additionalProperties": false
      }
    },
    "identity_rule": {
      "type": "object",
      "required": [
        "name",
        "implementation",
        "preserved_fields",
        "excluded_fields"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "implementation": {
          "type": "string",
          "minLength": 1
        },
        "preserved_fields": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "excluded_fields": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
