grid.alpha: 0.65
font.size: 10
font.family: sans-serif
font.sans-serif: DejaVu Sans, Arial, Liberation Sans
xtick.color: 0.42
ytick.color: 0.42
xtick.labelsize: 9
ytick.labelsize: 9
legend.frameon: False
legend.fontsize: 9
pdf.fonttype: 42
ps.fonttype: 42
svg.fonttype: none
